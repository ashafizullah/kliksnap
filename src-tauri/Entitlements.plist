<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The hardened runtime refuses the microphone without this: macOS denies
       access silently and KlikSnap never shows up under Privacy → Microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Likewise for the webcam bubble in recordings. -->
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
